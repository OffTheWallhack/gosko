{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), fullscreen=(self), screen-wake-lock=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/three@0.160.0/ https://challenges.cloudflare.com 'sha256-BeblsUyk8rszGwrSveDV7JEpzg6B/ojj95UlFdZLeJQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com https://flagcdn.com https://tile.openstreetmap.org https://tiles.openfreemap.org https://jfqsvekdufintkyyxvrx.supabase.co; connect-src 'self' https://jfqsvekdufintkyyxvrx.supabase.co https://tiles.openfreemap.org https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ghoskate.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mapa",
      "destination": "/hra",
      "permanent": true
    },
    {
      "source": "/mapa/",
      "destination": "/hra",
      "permanent": true
    },
    {
      "source": "/spot/:id",
      "destination": "/hra/spot/:id",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/hra/feed",
      "permanent": true
    },
    {
      "source": "/loadout",
      "destination": "/hra/loadout",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?:admin|checkin|crew|doska|event|eventy|feed|hra|import-passes|jazdci|jazdec|komunita|loadout|mapa|novinka|novinky|o-nas|parky|partner|partneri|pass|pravidla|profil|rebricek|registracia|rodicia|shop|sien-slavy|spot|spoty|sukromie|trik-tyzdna|tv)(?:/[^.]*)?)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/nft-retry",
      "schedule": "0 6 * * *"
    }
  ]
}
